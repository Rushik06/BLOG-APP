    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.4.0",
    "husky": "^9",
    "jsdom": "^29.0.1",
    "lint-staged": "^16",
    "minimatch": "^9.0.9",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.7.2",
